struct quad_joint_command_t 
{
    // 12 个腿关节和 4 个轮关节，顺序为 LF/RF/LR/RR。
    float joint_des_q[12];
    float joint_des_q_supplement[4];
    
    // 所有关节的期望速度
    float joint_des_qd[12];
    float joint_des_qd_supplement[4];

    // 所有关节的kp 
    float joint_des_kp[12];
    float joint_des_kp_supplement[4];

    // 所有关节的kd
    float joint_des_kd[12];
    float joint_des_kd_supplement[4];

    // 所有关节的期望扭矩
    float joint_des_tau[12];
    float joint_des_tau_supplement[4];
    
    // 电机使能标志位，与SPI结构体同步，一条腿一个
    int32_t flags[4];  
}
